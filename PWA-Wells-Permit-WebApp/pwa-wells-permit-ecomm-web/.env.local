REACT_APP_ENV=local

# Google Maps JavaScript API key for the project/well location pickers (public, client-side value).
# When empty, the wizard renders manual latitude/longitude inputs instead of a map.
REACT_APP_MAP_API_KEY=

# Invisible Google reCAPTCHA v2 site key protecting the Apply and Track pages (public value — safe
# to commit). When blank the captcha gate is disabled (fail-open) and the API relies on rate
# limiting. The matching backend secret is provided to the API via the Captcha__SecretKey env var
# (never committed).
REACT_APP_RECAPTCHA_SITE_KEY=

# Inactivity session timeout for the Apply wizard, in minutes. When unset the app falls back to 40.
REACT_APP_SESSION_TIMEOUT_MIN=40
